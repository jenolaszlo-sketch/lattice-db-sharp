+test "wal does not hide a checksum failure in a complete frame" {
+    const allocator = std.testing.allocator;
+
+    var posix_vfs = vfs.PosixVfs.init(allocator);
+    const vfs_impl = posix_vfs.vfs();
+
+    const path = "/tmp/lattice_wal_test_mid_log_checksum.wal";
+    vfs_impl.delete(path) catch {};
+
+    var uuid: [16]u8 = undefined;
+    @import("compat").randomBytes(&uuid);
+
+    {
+        var wal = try WalManager.init(allocator, vfs_impl, path, uuid);
+        _ = try wal.appendRecord(.txn_begin, 1, 0, &[_]u8{});
+        try wal.sync();
+        _ = try wal.appendRecord(.insert, 1, 1, "committed");
+        try wal.sync();
+        wal.deinit();
+    }
+
+    {
+        var file = try vfs_impl.open(path, .{ .read = true, .write = true });
+        var corrupted = [_]u8{0xff};
+        try file.write(WAL_HEADER_SIZE + @sizeOf(WalFrameHeader), &corrupted);
+        file.close();
+    }
+
+    const result = WalManager.init(allocator, vfs_impl, path, uuid);
+    try std.testing.expectError(WalError.ChecksumMismatch, result);
+    vfs_impl.delete(path) catch {};
+}
