+test "wal recovers an incomplete final declared frame without a hole" {
+    const allocator = std.testing.allocator;
+
+    var posix_vfs = vfs.PosixVfs.init(allocator);
+    const vfs_impl = posix_vfs.vfs();
+
+    const path = "/tmp/lattice_wal_test_truncated_tail.wal";
+    vfs_impl.delete(path) catch {};
+
+    var uuid: [16]u8 = undefined;
+    @import("compat").randomBytes(&uuid);
+
+    {
+        var wal = try WalManager.init(allocator, vfs_impl, path, uuid);
+        _ = try wal.appendRecord(.txn_begin, 1, 0, &[_]u8{});
+        try wal.sync();
+        _ = try wal.appendRecord(.insert, 1, 1, "committed");
+        try wal.sync();
+        wal.deinit();
+    }
+
+    const torn_size = WAL_HEADER_SIZE + @as(u64, FRAME_SIZE) + @as(u64, FRAME_SIZE / 2);
+    {
+        var file = try vfs_impl.open(path, .{ .read = true, .write = true });
+        try file.truncate(torn_size);
+        file.close();
+    }
+
+    {
+        var wal = try WalManager.init(allocator, vfs_impl, path, uuid);
+        try std.testing.expectEqual(@as(u64, 1), wal.header.frame_count);
+        _ = try wal.appendRecord(.txn_commit, 1, 0, &[_]u8{});
+        try wal.sync();
+        try std.testing.expectEqual(
+            WAL_HEADER_SIZE + @as(u64, FRAME_SIZE) * 2,
+            try wal.file.size(),
+        );
+        wal.deinit();
+    }
+
+    {
+        var wal = try WalManager.init(allocator, vfs_impl, path, uuid);
+        defer {
+            wal.deinit();
+            vfs_impl.delete(path) catch {};
+        }
+        try std.testing.expectEqual(@as(u64, 2), wal.header.frame_count);
+        var iter = wal.iterate(1);
+        var buf: [256]u8 = undefined;
+        var count: u64 = 0;
+        while (try iter.next(&buf)) |_| count += 1;
+        try std.testing.expectEqual(@as(u64, 2), count);
+    }
+}
