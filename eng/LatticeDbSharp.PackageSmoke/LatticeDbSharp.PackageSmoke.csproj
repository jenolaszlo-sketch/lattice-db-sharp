<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SmokePackageVersion Condition="'$(SmokePackageVersion)' == ''">0.0.0-package-version-required</SmokePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LatticeDbSharp" Version="$(SmokePackageVersion)" />
  </ItemGroup>
</Project>
