<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>LatticeDbSharp</PackageId>
    <Title>LatticeDbSharp</Title>
    <Description>Safe, idiomatic .NET bindings for the LatticeDB native C API.</Description>
    <Authors>LatticeDbSharp contributors</Authors>
    <PackageTags>latticedb;graph;database;cypher;vector-search;full-text-search;native;interop</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LatticeDB.NativeVersion" Value="$(LatticeDbNativeVersion)" />
    <AssemblyMetadata Include="LatticeDB.NativeCommit" Value="$(LatticeDbNativeCommit)" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../native/upstream.json" Pack="true" PackagePath="/build/LatticeDbSharp/" />
    <None Include="../../native/capabilities.json" Pack="true" PackagePath="/build/LatticeDbSharp/" />
    <None Include="../../native/zig-toolchains.json" Pack="true" PackagePath="/build/LatticeDbSharp/" />
    <None Include="../../native/patches/**/*"
          Pack="true"
          PackagePath="/build/LatticeDbSharp/native/patches/"
          Condition="Exists('../../native/patches')" />
    <None Include="../../native/LICENSE.LatticeDB" Pack="true" PackagePath="/THIRD_PARTY_LICENSES/" />
    <None Include="../../native/staging/linux-x64/liblattice.so"
          Pack="true"
          PackagePath="/runtimes/linux-x64/native/"
          Condition="Exists('../../native/staging/linux-x64/liblattice.so')" />
    <None Include="../../native/staging/linux-x64/asset.json"
          Pack="true"
          PackagePath="/build/LatticeDbSharp/native/linux-x64/"
          Condition="Exists('../../native/staging/linux-x64/asset.json')" />
    <None Include="../../native/staging/linux-x64/abi.json"
          Pack="true"
          PackagePath="/build/LatticeDbSharp/native/linux-x64/"
          Condition="Exists('../../native/staging/linux-x64/abi.json')" />
    <None Include="../../native/staging/win-x64/lattice.dll"
          Pack="true"
          PackagePath="/runtimes/win-x64/native/"
          Condition="Exists('../../native/staging/win-x64/lattice.dll')" />
    <None Include="../../native/staging/win-x64/asset.json"
          Pack="true"
          PackagePath="/build/LatticeDbSharp/native/win-x64/"
          Condition="Exists('../../native/staging/win-x64/asset.json')" />
    <None Include="../../native/staging/win-x64/abi.json"
          Pack="true"
          PackagePath="/build/LatticeDbSharp/native/win-x64/"
          Condition="Exists('../../native/staging/win-x64/abi.json')" />
    <None Include="../../native/staging/osx-arm64/liblattice.dylib"
          Pack="true"
          PackagePath="/runtimes/osx-arm64/native/"
          Condition="Exists('../../native/staging/osx-arm64/liblattice.dylib')" />
    <None Include="../../native/staging/osx-arm64/asset.json"
          Pack="true"
          PackagePath="/build/LatticeDbSharp/native/osx-arm64/"
          Condition="Exists('../../native/staging/osx-arm64/asset.json')" />
    <None Include="../../native/staging/osx-arm64/abi.json"
          Pack="true"
          PackagePath="/build/LatticeDbSharp/native/osx-arm64/"
          Condition="Exists('../../native/staging/osx-arm64/abi.json')" />
  </ItemGroup>
  <Target Name="RequireVerifiedNativeAssetForPack" BeforeTargets="Pack">
    <Error Condition="!Exists('../../native/staging/linux-x64/liblattice.so')"
           Text="Pack requires the verified linux-x64 native library. Run eng/Build-Native.ps1 first." />
    <Error Condition="!Exists('../../native/staging/linux-x64/asset.json')"
           Text="Pack requires native/staging/linux-x64/asset.json." />
    <Error Condition="!Exists('../../native/staging/linux-x64/abi.json')"
           Text="Pack requires native/staging/linux-x64/abi.json." />
    <Error Condition="!Exists('../../native/staging/win-x64/lattice.dll')"
           Text="Pack requires the verified win-x64 native library. Run eng/Build-Native.ps1 on Windows first." />
    <Error Condition="!Exists('../../native/staging/win-x64/asset.json')"
           Text="Pack requires native/staging/win-x64/asset.json." />
    <Error Condition="!Exists('../../native/staging/win-x64/abi.json')"
           Text="Pack requires native/staging/win-x64/abi.json." />
    <Error Condition="!Exists('../../native/staging/osx-arm64/liblattice.dylib')"
           Text="Pack requires the verified osx-arm64 native library. Run eng/Build-Native.ps1 on macOS ARM64 first." />
    <Error Condition="!Exists('../../native/staging/osx-arm64/asset.json')"
           Text="Pack requires native/staging/osx-arm64/asset.json." />
    <Error Condition="!Exists('../../native/staging/osx-arm64/abi.json')"
           Text="Pack requires native/staging/osx-arm64/abi.json." />
  </Target>
</Project>
